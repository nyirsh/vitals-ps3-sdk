+/// The segment holding the TOC, which `.TOC.` (r2) is measured from: the one
+/// holding `__lv2_got_start`, where the linker scripts start it, or `.got`.
+/// `.TOC.` itself is that start + 0x8000 and can lie past the segment's end;
+/// so can `__lv2_got_start`, at the very end of a segment when the TOC is
+/// empty. `None` without either (no TOC, or not one of these scripts).
+fn toc_segment(elf: &Elf, loads: &[Phdr]) -> Option<usize> {
+    let start = elf
+        .syms
+        .iter()
+        .find(|s| s.name == "__lv2_got_start" && s.st_shndx != SHN_UNDEF)
+        .map(|s| s.st_value)
+        .or_else(|| elf.shdrs.iter().find(|s| s.name == ".got" && s.is_alloc()).map(|s| s.sh_addr))?;
+    loads
+        .iter()
+        .position(|p| p.contains_vaddr(start))
+        .or_else(|| loads.iter().position(|p| p.p_memsz > 0 && start == p.p_vaddr + p.p_memsz))
+}
+
+/// Where the linked branch instruction at `offset` (in `segment`) goes.
+fn branch_target(elf: &Elf, segment: &Phdr, r_type: u32, offset: u64) -> Result<u64> {
+    if offset < segment.p_vaddr || offset + 4 > segment.p_vaddr + segment.p_filesz {
+        bail!("branch at 0x{:x} is not in its segment's file image", offset);
+    }
+    let at = (segment.p_offset + (offset - segment.p_vaddr)) as usize;
+    if at + 4 > elf.data.len() {
+        bail!("branch at 0x{:x} is past the end of the file", offset);
+    }
+    let insn = crate::elf::rd_u32(&elf.data, at);
+    if insn & 2 != 0 {
+        bail!("branch at 0x{:x} is absolute (AA set), which a relocation of type {} cannot be", offset, r_type);
+    }
+    let displacement = if r_type == R_PPC64_REL24 {
+        (((insn & 0x03ff_fffc) << 6) as i32 >> 6) as i64
+    } else {
+        ((insn & 0xfffc) as u16 as i16) as i64
+    };
+    Ok(offset.wrapping_add(displacement as u64))
+}
